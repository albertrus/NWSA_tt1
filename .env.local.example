# PostgreSQL database (Neon, Supabase, or any Postgres provider)
# For Neon: get this from your Neon project dashboard
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# NextAuth configuration
# Generate a secure secret: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-characters-long"

# Google OAuth credentials
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URI to: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple OAuth credentials
# Create an App ID and Service ID at https://developer.apple.com/account/resources/identifiers/list
# Set Return URL to: http://localhost:3000/api/auth/callback/apple
APPLE_ID="com.your.app.service-id"
APPLE_SECRET="your-apple-client-secret-jwt"

# Facebook OAuth credentials
# Create an app at https://developers.facebook.com/apps/
# Add OAuth redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# Shopify Storefront API (for Shop Pay checkout)
# Create a private app in your Shopify admin > Apps > Develop apps
# Requires Storefront API access with unauthenticated_read_checkouts scope
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN="your-storefront-api-token"
NEXT_PUBLIC_SHOPIFY_VARIANT_ID="gid://shopify/ProductVariant/YOUR_VARIANT_ID"

# Apple Pay (Web Payments API)
# Register your domain at https://developer.apple.com/documentation/apple_pay_on_the_web
NEXT_PUBLIC_APPLE_PAY_MERCHANT_ID="merchant.com.your.app"

# Google Pay (Web Payments API via Stripe)
# Register at https://pay.google.com/business/console
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID="your-google-pay-merchant-id"

# Stripe (payment processor for Apple Pay and Google Pay tokens)
# Get keys from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
